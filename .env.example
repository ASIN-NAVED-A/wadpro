# API Base URL for backend service
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Maximum resume upload size in Megabytes
VITE_MAX_UPLOAD_SIZE_MB=5

# Feature Flags for Mocking Endpoints Not Yet Available in Backend
# Set to false once the backend implements and exposes the respective endpoint
VITE_USE_MOCKS_PROFILE=true
VITE_USE_MOCKS_APPLICATIONS=true
VITE_USE_MOCKS_RECOMMENDATIONS=true
VITE_USE_MOCKS_RESUME=true

# Fallback to simulated demo data if backend connection fails (e.g. backend server offline)
VITE_ENABLE_DEMO_FALLBACK=true
